  "baseline_artifact_rule": "Every specialist adapter must emit a self-contained exact-decode artifact and count its complete envelope, type/shape/timestamp metadata, codec payload, padding, checksum, and footer. In-memory payload-bit counters are inadmissible.",
  "baseline_applicability_rule": "A baseline applies only when its declared track or dtype matches the item. Chimp and Gorilla additionally require a source-provided complete timestamp column; they are ineligible for value-only series, and synthetic timestamps are forbidden. Every declared track must retain at least one applicable specialist plus generic controls.",
  "toolchain_lock_rule": "Before any measurement, a separate reviewed acquisition lock must bind source archive SHA-256, source tree revision, license digest, compiler and runtime versions, adapter source SHA-256, built binary SHA-256, and the exact expanded command for every baseline. Any null binary_sha256 keeps measurement_authorized false.",
  "gates": {
    "training": {
      "exact_all_items": true,
      "aggregate_complete_bytes_at_most_fraction_of_strongest_applicable_baseline": 0.94,
      "each_declared_track_complete_bytes_at_most_fraction_of_strongest_applicable_baseline": 0.94,
      "maximum_per_item_regression_vs_safe_direct_or_store_fraction": 0.005,
      "compression_mbps_minimum": 300.0,
      "decompression_mbps_minimum": 1000.0,
      "compression_speed_fraction_of_fastest_ratio_baseline_minimum": 0.5,
      "decompression_speed_fraction_of_fastest_ratio_baseline_minimum": 0.8,
      "peak_rss_bytes_maximum": 536870912,
      "stream_chunk_bytes_maximum": 67108864,
      "two_identical_encoded_repetitions": true,
      "cross_arch_same_encoded_sha256": true,
      "cross_arch_cross_decode_exact": true,
      "corruption_and_truncation_suite": true
    },
    "future_validation": {
      "authorization": "only after training candidate, runner, commands, and gates are frozen",
      "aggregate_and_each_track_advancement_fraction": 0.06,
      "no_tuning_or_rerun": true
    },
    "future_private_holdout": {
      "authorization": "only after one clean validation pass and independent protocol review",
      "aggregate_and_each_track_advancement_fraction": 0.05,
      "threshold_rationale": "the one-shot independently controlled holdout allows one percentage point for ordinary split variance after the unchanged candidate first clears 6% on training and fresh validation; it is not a retuning allowance",
      "one_shot": true,
      "independent_custodian": true
    }
  },
  "timing": {
    "host": "dedicated pinned Linux x86_64 plus independent arm64 cross-architecture gate",
    "process": "fresh child process and fresh atomic destination per trial",
    "warmups_per_item_variant": 1,
    "measured_rounds": 7,
    "order": "predeclared alternating Latin-style order",
    "included": [
      "startup",
      "input read",
      "type and shape validation",
      "candidate analysis and selector probes",
      "compression or decompression",
      "all metadata checksums and indexes",
      "output write flush and atomic publication",
      "restored SHA-256 verification"
    ],
    "excluded": [
      "corpus acquisition",
      "tool compilation"
    ],
    "rss": "cold child peak RSS from wait4 or platform-equivalent whole-process accounting"
  },
  "required_next_artifacts": [
    "licensed training manifest",
    "external baseline acquisition and binary lock",
    "candidate format specification",
    "candidate implementation commit and binary digest",
    "frozen benchmark runner and verifier",
    "synthetic exactness corruption determinism and cross-architecture tests"
  ],
  "results": null
}
