      "applies_to": [
        "float32_time_series",
        "float64_time_series"
      ],
      "repository": "https://github.com/ghilesmeddour/gorilla-time-series-compression.git",
      "revision": "093544c6e643aef911ff83527f595bc2d9280ed8",
      "license": "MIT",
      "license_file": "LICENSE",
      "binary": "build/baselines/numr-gorilla",
      "build": "python -m build third_party/gorilla-time-series-compression && python -m pip install --no-deps third_party/gorilla-time-series-compression/dist/gorillacompression-1.0.2-py3-none-any.whl",
      "encode": "numr-gorilla encode --dtype {dtype} --timestamps {timestamps} --input {input} --output {output}",
      "decode": "numr-gorilla decode --input {input} --output {output}",
      "binary_sha256": null
    },
