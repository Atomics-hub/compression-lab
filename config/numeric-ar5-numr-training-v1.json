      "encode": "numr-blosc2 encode --codec zstd --level 9 --filter shuffle --typesize {typesize} --input {input} --output {output}",
      "decode": "numr-blosc2 decode --input {input} --output {output}",
      "binary_sha256": null
    },
    {
      "id": "blosc2-bytedelta-zstd",
      "applies_to": [
        "all"
      ],
      "repository": "https://github.com/Blosc/c-blosc2.git",
