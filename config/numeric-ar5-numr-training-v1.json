      "build": "mvn -f third_party/chimp/pom.xml -DskipTests=false package",
      "encode": "java -jar numr-chimp.jar encode --codec chimp128 --dtype float64 --timestamps {timestamps} --input {input} --output {output}",
      "decode": "java -jar numr-chimp.jar decode --input {input} --output {output}",
      "binary_sha256": null
    },
