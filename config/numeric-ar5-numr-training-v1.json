      "license": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "binary": "build/baselines/numr-blosc2",
      "build": "cmake -S third_party/c-blosc2 -B build/c-blosc2 -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF -DBUILD_EXAMPLES=OFF && cmake --build build/c-blosc2 --parallel 1",
      "encode": "numr-blosc2 encode --codec zstd --level 9 --filter bytedelta,shuffle --typesize {typesize} --input {input} --output {output}",
      "decode": "numr-blosc2 decode --input {input} --output {output}",
      "binary_sha256": null
    },
